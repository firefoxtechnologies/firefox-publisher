{
  "name": "firefox-publisher",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "build": {
    "command": "npm ci --prefix website-react && npm run build --prefix website-react"
  },
  "assets": {
    "directory": "./website-react/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the form endpoint goes through the Worker; the rest of the site is served as static files.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Routing must be on for the domain, and MAIL_TO must be a verified
  // destination address (Email Routing > Destination addresses).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "MAIL_TO": "contactus@firefoxpublisher.com",
    "MAIL_FROM": "website@firefoxpublisher.com"
  }
}
